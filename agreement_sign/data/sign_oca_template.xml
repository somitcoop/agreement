<odoo>
    <record id="sign_template_agreement" model="sign.oca.template">
        <field name="name">Agreement Template</field>
        <field name="model_id" ref="agreement_legal.model_agreement"/>
    </record>

    <record id="sign_template_agreement_signature" model="sign.oca.template.item">
        <field name="template_id" ref="sign_template_agreement"/>
        <field name="role_id" ref="sign_role_agreement"/>
        <field name="field_id" ref="sign_oca.sign_field_signature"/>
        <field name="page">1</field>
        <field name="position_x">10</field>
        <field name="position_y">90</field>
        <field name="width">40</field>
        <field name="height">10</field>
        <field name="required" eval="True"/>
    </record>
</odoo>
