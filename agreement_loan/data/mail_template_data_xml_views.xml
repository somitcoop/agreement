<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_loan_agreement" model="mail.template">
            <field name="name">Loan Agreement - Send by Email</field>
            <field name="model_id" ref="agreement.model_agreement"/>
            <field name="subject">Loan Agreement ${object.name}</field>
            <field name="email_from">${user.email_formatted | safe}</field>
            <field name="partner_to">${object.partner_id.id}</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear ${object.partner_id.name},
                        <br/><br/>
                        Please find attached the loan agreement ${object.name}.
                        <br/><br/>
                        Best regards,
                        <br/>
                        ${user.company_id.name}
                    </p>
                </div>
            </field>
            <!-- <field name="report_template" ref="agreement_legal.report_agreement_document"/> -->
        </record>
    </data>
</odoo>
